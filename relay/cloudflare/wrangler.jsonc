{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tbd-relay",
  "main": "src/index.ts",
  // Serve on the free <name>.<subdomain>.workers.dev address; no domain is needed.
  "workers_dev": true,
  // The workerd that Wrangler 4.152.0 bundles. Any date after 2026-04-07 turns on
  // web_socket_auto_reply_to_close, so the runtime answers Close frames itself.
  "compatibility_date": "2026-10-19",
  // The relay keeps no logs.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // The Free plan offers only SQLite-backed Durable Objects. The relay stores nothing in it.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
