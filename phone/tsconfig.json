{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": []
  },
  "include": ["loader/**/*.js"],
  "exclude": ["loader/**/*.test.js", "loader/test/**", "loader/vendor/**"]
}
