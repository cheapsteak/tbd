        "id": "login-8",
        "kind": "tool",
        "truncated": false,
        "toolName": "Bash",
        "target": "npm test -- auth",
        "toolStatus": "ok"
      },
      {
        "id": "login-9",
        "kind": "systemNote",
        "text": "PostToolUse: eslint src/auth passed.",
        "truncated": false
      },
      {
        "id": "login-10",
        "kind": "assistant",
        "text": "Fixed. Here is what changed:\n\n- `finishLogin` now keeps the `next` value from the sign-in link.\n- A new `isLocalPath` check refuses any link to another site, so `next=https://evil.example` falls back to `/home`.\n- The auth tests pass, 9 of 9.",
        "truncated": true
      }
