    "local:00000000-0000-4000-8000-000000000102": [
      {
        "id": "login-1",
        "kind": "user",
        "text": "After sign-in we always land on /home, even when someone came from a deep link. Send people back to where they started.",
        "truncated": false
      },
      {
        "id": "login-2",
        "kind": "thinking",
        "text": "The redirect target is probably lost in the sign-in callback. Look at finishLogin first.",
        "truncated": false
      },
      {
        "id": "login-3",
        "kind": "subagent",
        "truncated": false,
        "toolName": "Agent",
        "target": "Find where the post-login redirect is decided",
        "toolStatus": "ok",
        "agentType": "Explore",
        "itemCount": 14
      },
